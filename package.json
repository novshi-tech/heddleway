{
  "name": "heddleway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "python3 tools/build-plugin-zip.py --bundle && wrangler dev -c wrangler.example.jsonc",
    "deploy": "node tools/wrangler.mjs deploy",
    "secret": "node tools/wrangler.mjs secret",
    "tail": "node tools/wrangler.mjs tail",
    "d1-migrate": "node tools/wrangler.mjs d1-migrate",
    "postinstall": "npm ci --prefix topic-index --no-audit --no-fund",
    "typecheck": "python3 tools/build-plugin-zip.py --bundle && tsc --noEmit",
    "test": "vitest run && python3 -m unittest discover -s test/scripts",
    "cf-typegen": "wrangler types -c wrangler.example.jsonc",
    "plugin:zip": "python3 tools/build-plugin-zip.py",
    "plugin:sync": "python3 tools/sync-plugin-libs.py"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.1.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.141.0"
  }
}
